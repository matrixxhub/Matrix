        local heartPoints = {}
        local particleCount = 48
        for i = 1, particleCount do
            local t = (i / particleCount) * math.pi * 2
            local x = 16 * math.sin(t)^3
            local y = 13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t)
            heartPoints[i] = Vector2.new(0.5 + x / 38, 0.48 - y / 38)
