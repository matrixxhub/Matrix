local spoofNameText = "MATRIXHUB"
local isWorkspaceLooping = false

-- Seguimiento por eventos: evita recorrer todo el juego cada segundo.
local nameRootConnections = {}
local nameTextConnections = {}
local trackedNameLabels = {}
local modifiedNameLabels = setmetatable({}, { __mode = "k" })

local function safeReplace(str, findText, replaceText)
    if type(str) ~= "string" or type(findText) ~= "string" or findText == "" then
        return str
    end

    local safeFind = findText:gsub("([%(%)%.%%%+%-%*%?%[%]%^%$])", "%%%1")
    -- Usar función de reemplazo para que '%' escrito por el usuario sea literal.
    return (str:gsub(safeFind, function()
        return replaceText
    end))
end

local function processText(v, myName, myDisp)
    if not v or not v.Parent then return end
    if not (v:IsA("TextLabel") or v:IsA("TextBox") or v:IsA("TextButton")) then return end

    local parentGui = v:FindFirstAncestorWhichIsA("ScreenGui")
    if parentGui and (string.find(parentGui.Name, "WindUI", 1, true)
        or string.find(parentGui.Name, "MATRIXHUB", 1, true)) then
        return
    end

    local txt = v.Text
    if not txt or txt == "" then return end

    local hasName = (myName ~= "" and string.find(txt, myName, 1, true) ~= nil)
        or (myDisp ~= "" and string.find(txt, myDisp, 1, true) ~= nil)

    if hasName then
        v.RichText = true
        local newText = safeReplace(txt, myName, spoofNameText)
        newText = safeReplace(newText, myDisp, spoofNameText)

        if newText ~= txt then
            modifiedNameLabels[v] = true
            v.Text = newText
        end
    end
end

local function disconnectNameWatcher()
    for _, connection in ipairs(nameRootConnections) do
        if connection then connection:Disconnect() end
    end
    for _, connection in ipairs(nameTextConnections) do
        if connection then connection:Disconnect() end
    end

    table.clear(nameRootConnections)
    table.clear(nameTextConnections)
    table.clear(trackedNameLabels)
end

local function attachNameTextObject(v)
    if not isWorkspaceLooping or trackedNameLabels[v] then return end
    if not (v:IsA("TextLabel") or v:IsA("TextBox") or v:IsA("TextButton")) then return end

    trackedNameLabels[v] = true

    local connection = v:GetPropertyChangedSignal("Text"):Connect(function()
        if isWorkspaceLooping then
            pcall(processText, v, player.Name, player.DisplayName)
        end
    end)
    table.insert(nameTextConnections, connection)

    pcall(processText, v, player.Name, player.DisplayName)
end

local function watchNameRoot(root)
    if not root or not isWorkspaceLooping then return end

    table.insert(nameRootConnections, root.DescendantAdded:Connect(attachNameTextObject))

    -- Una sola inspección inicial, dividida en bloques para no congelar la interfaz.
    task.spawn(function()
        local descendants = root:GetDescendants()
        for index, descendant in ipairs(descendants) do
            if not isWorkspaceLooping then return end
            attachNameTextObject(descendant)

            if index % 150 == 0 then
                task.wait()
            end
        end
    end)
end

Otros:Toggle({
    Title = "OCULTAR NOMBRE",
    Value = false,
    Callback = function(state)
        if state == isWorkspaceLooping then return end
        isWorkspaceLooping = state

        if not state then
            disconnectNameWatcher()
            return
        end

        -- Solo se revisan los contenedores donde normalmente aparecen interfaces
        -- y etiquetas sobre personajes, no todos los servicios del juego.
        watchNameRoot(workspace)

        local playerGui = player:FindFirstChildOfClass("PlayerGui")
        if playerGui then
            watchNameRoot(playerGui)
        end

        -- También cubre el caso en que PlayerGui aparezca después de activar la opción.
        table.insert(nameRootConnections, player.ChildAdded:Connect(function(child)
            if isWorkspaceLooping and child:IsA("PlayerGui") then
                watchNameRoot(child)
            end
        end))
    end
})

Otros:Input({
    Title = "NOMBRE FALSO",
    Placeholder = "XXX-XXXX-XXX",
    Value = "MATRIXHUB",
    Callback = function(text)
        if text ~= "" and text ~= spoofNameText then
            local previousName = spoofNameText
            spoofNameText = text

            -- Actualiza solo los textos que esta función ya había modificado.
            for label in pairs(modifiedNameLabels) do
                if label and label.Parent then
                    pcall(function()
                        label.Text = safeReplace(label.Text, previousName, spoofNameText)
                    end)
                else
                    modifiedNameLabels[label] = nil
                end
            end
        end
    end
})

