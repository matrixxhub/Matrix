    if not startupGui.Parent then
        if startupRainConnection then startupRainConnection:Disconnect() startupRainConnection = nil end
        return
    end
    startupRainAccumulator += dt
    if startupRainAccumulator < 1 / 20 then return end
    local step = math.min(startupRainAccumulator, 0.12)
    startupRainAccumulator = 0
    for _, column in ipairs(startupRain) do
        column.Y += step * column.Speed
        if column.Y > 1.08 then
            column.Y = startupRandom:NextNumber(-0.8, -0.2)
            local chars = {}
            for n = 1, 9 do
                chars[n] = startupGlyphs[startupRandom:NextInteger(1, #startupGlyphs)]
