local lastMatrixClickSound = 0
local function PlayMatrixUISound(soundKey)
    if not MATRIXHUB_CONFIG.UIAudioEnabled then return end
    local now = os.clock()
    if now - lastMatrixClickSound < 0.055 then return end -- evita dobles sonidos del mismo clic
    lastMatrixClickSound = now
    local sound = MatrixUISoundObjects.Click
    if not sound then return end
    sound:Stop()
    sound.SoundId = MATRIXHUB_BUTTON_SOUND_ID
    sound.Volume = math.clamp(MATRIXHUB_CONFIG.UIAudioVolume, 0, 1)
    pcall(function() sound:Play() end)
end

