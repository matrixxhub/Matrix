local function MATRIXHUB_Noclip(char, dir)
    if not MATRIXHUB_noclipOn then return end
    if dir.Magnitude == 0 then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local head = char:FindFirstChild("Head")
    local alturaCabeza = head and head.Position.Y or (hrp.Position.Y + 2)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {char}
    params.IgnoreWater = true
    local dirArriba = (dir + Vector3.new(0, 0.6, 0)).Unit
    local result = workspace:Raycast(hrp.Position, dirArriba * 4, params)
    if not result then
        result = workspace:Raycast(hrp.Position, Vector3.new(0, 1, 0) * 5, params)
    end
    if result and result.Instance and result.Instance.CanCollide then
        local pared = result.Instance
        if pared.Position.Y < alturaCabeza then
            return
        end
        if pared.Name == "Baseplate" or pared.Name == "Floor" then
            return
        end
        pared.CanCollide = false
        task.delay(0.35, function()
            pcall(function()
                if pared and pared.Parent then
                    pared.CanCollide = true
                end
            end)
        end)
    end
end

local function MATRIXHUB_StartFly()
    if MATRIXHUB_flying then return end
    MATRIXHUB_flying = true
    local char = MATRIXHUB_LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then MATRIXHUB_flying = false return end
    MATRIXHUB_baseY = root.Position.Y
    if MATRIXHUB_flyConn then MATRIXHUB_flyConn:Disconnect() end
    MATRIXHUB_flyConn = game:GetService("RunService").RenderStepped:Connect(function()
        if not MATRIXHUB_flying then return end
        local c = MATRIXHUB_LP.Character
        if not c then return end
        local root = c:FindFirstChild("HumanoidRootPart")
        local h = c:FindFirstChildOfClass("Humanoid")
        if not root or not h then return end
        local cam = workspace.CurrentCamera
        local speed = MATRIXHUB_cframeOn and MATRIXHUB_speed or 0.6
        local dir = Vector3.zero
        if MATRIXHUB_keys.Up then dir += Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) end
        if MATRIXHUB_keys.Down then dir -= Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z) end
        if MATRIXHUB_keys.Left then dir -= Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z) end
        if MATRIXHUB_keys.Right then dir += Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z) end
        if dir.Magnitude > 0 then dir = dir.Unit end
        local y = 0
        if MATRIXHUB_keys.Space then y = 1.25 end
        if MATRIXHUB_keys.Shift then y = -1.25 end
        MATRIXHUB_Noclip(c, dir)
        if MATRIXHUB_frozen then
            root.Anchored = true
            local move = Vector3.new(dir.X * speed, y, dir.Z * speed)
            local rot = root.CFrame - root.CFrame.Position
            root.CFrame = CFrame.new(root.Position + move) * rot
        else
            root.Anchored = false
            local targetY = MATRIXHUB_baseY + MATRIXHUB_altura
            local diff = targetY - root.Position.Y
            local upAuto = 0
            if math.abs(diff) > 0.5 then upAuto = math.clamp(diff * 0.08, -1.2, 1.2) end
            local move = Vector3.new(dir.X * speed, upAuto + y, dir.Z * speed)
            local rot = root.CFrame - root.CFrame.Position
            root.CFrame = CFrame.new(root.Position + move) * rot
        end
        root.AssemblyLinearVelocity = Vector3.zero
    end)
end

local function MATRIXHUB_StopFly()
    MATRIXHUB_flying = false
    MATRIXHUB_frozen = false
    if MATRIXHUB_flyConn then MATRIXHUB_flyConn:Disconnect() MATRIXHUB_flyConn = nil end
    local char = MATRIXHUB_LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    hrp.Anchored = false
    hum.PlatformStand = false
    hrp.AssemblyLinearVelocity = Vector3.zero
    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
end

MATRIXHUB_KEY_ACTIONS.Fly = function()
    if MATRIXHUB_flying then
        MATRIXHUB_StopFly()
    else
        MATRIXHUB_StartFly()
    end
end

