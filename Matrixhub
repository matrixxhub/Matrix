                ghostMessage.TextTransparency = 0.04
                ghostMessage.Visible = true
                ghostMessageActive = true
            end
        end

        if ghostMessageActive then
            ghostMessageY += step * ghostMessageSpeed
            ghostMessage.Position = UDim2.new(0.5, 0, ghostMessageY, 0)
            if ghostMessageY > 0.72 then
                ghostMessage.TextTransparency = math.clamp(0.04 + (ghostMessageY - 0.72) * 2.6, 0.04, 1)
            end
            if ghostMessageY > 1.08 then
                ghostMessage.Visible = false
                ghostMessageActive = false
            end
        end
    end)
