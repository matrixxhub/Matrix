    for _, targetPlayer in ipairs(Players:GetPlayers()) do
        local character = targetPlayer.Character
        if character then
            local hitbox = character:FindFirstChild("MATRIXHUB_HITBOX")
            if hitbox then hitbox:Destroy() end
        end
    end
end

