    local function MATRIXHUB_IsPistolTool(tool)
        if not tool or not tool:IsA("Tool") then return false end
        if type(esPistola) == "function" then
            local ok, result = pcall(esPistola, tool)
            if ok then return result == true end
        end
        return tool:FindFirstChild("showBeam") ~= nil
    end

    local function MATRIXHUB_FindSlot2Pistol()
        local character = LocalPlayer.Character
        if character then
            for _, item in ipairs(character:GetChildren()) do
                if MATRIXHUB_IsPistolTool(item) then return item end
            end
        end

        local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
        if backpack then
            for _, item in ipairs(backpack:GetChildren()) do
                if MATRIXHUB_IsPistolTool(item) then return item end
            end
        end
        return nil
    end

