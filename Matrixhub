local AnimationNodes = {
    {Parent = "idle", Child = "Animation1", Key = "idle1"},
    {Parent = "idle", Child = "Animation2", Key = "idle2"},
    {Parent = "walk", Child = "WalkAnim", Key = "walk"},
    {Parent = "run", Child = "RunAnim", Key = "run"},
    {Parent = "jump", Child = "JumpAnim", Key = "jump"},
    {Parent = "fall", Child = "FallAnim", Key = "fall"},
}
local OriginalAnimationIds = setmetatable({}, {__mode = "k"})

local function getAnimationObject(animate, node)
    local folder = animate and animate:FindFirstChild(node.Parent)
    local animation = folder and folder:FindFirstChild(node.Child)
    if animation and animation:IsA("Animation") then
        return animation
    end
    return nil
end

local function captureDefaultAnimationIds(char)
    if not char then return false end
    if OriginalAnimationIds[char] then return true end

    local animate = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 8)
    if not animate then return false end

    local snapshot = {}
    for _, node in ipairs(AnimationNodes) do
        local animation = getAnimationObject(animate, node)
        if animation then
            snapshot[node.Key] = animation.AnimationId
        end
    end

    if next(snapshot) then
        OriginalAnimationIds[char] = snapshot
        return true
    end
    return false
end

local function stopCharacterAnimationTracks(hum)
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    if not animator and hum then
        animator = Instance.new("Animator")
        animator.Parent = hum
    end
    if not animator then return end

    local ok, tracks = pcall(function()
        return animator:GetPlayingAnimationTracks()
    end)
    if ok and tracks then
        for _, track in ipairs(tracks) do
            pcall(function()
                track:Stop(0.12)
            end)
        end
    end
end

local function ApplyAnims(ids)
    local char = LP.Character
    if not char then return false end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local animate = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 5)
    if not hum or not animate then
        warn("Matrix Hub: no se encontró Humanoid o Animate para aplicar el paquete.")
        return false
    end

    -- Captura los IDs originales solo la primera vez para no guardar un paquete encima de otro.
    captureDefaultAnimationIds(char)

    animate.Enabled = false
    for _, node in ipairs(AnimationNodes) do
        local animation = getAnimationObject(animate, node)
        local newId = ids and ids[node.Key]
        -- En el mezclador, Ninguno recupera el valor original de esa categoría;
        -- nunca se escribe rbxassetid://0 porque deja esa pista sin animación.
        if newId == nil or newId == "" or newId == "rbxassetid://0" then
            local defaults = OriginalAnimationIds[char]
            newId = defaults and defaults[node.Key]
        end
        if animation and type(newId) == "string" and newId ~= "" and newId ~= "rbxassetid://0" then
            animation.AnimationId = newId
        end
    end

    stopCharacterAnimationTracks(hum)
    task.wait(0.08)

    if LP.Character ~= char or not animate.Parent then
        return false
    end
    animate.Enabled = true
    if hum.Health > 0 then
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    return true
end

local function RestoreDefaultAnims()
    local char = LP.Character
    if not char then return false end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local animate = char:FindFirstChild("Animate") or char:WaitForChild("Animate", 5)
    if not hum or not animate then
        warn("Matrix Hub: no se encontró Animate. Si se eliminó con una versión anterior, reaparece al renacer el personaje.")
        return false
    end

    if not OriginalAnimationIds[char] then
        captureDefaultAnimationIds(char)
    end
    local snapshot = OriginalAnimationIds[char]
    if not snapshot then
        warn("Matrix Hub: no fue posible obtener las animaciones originales de este personaje.")
        return false
    end

    SelectedPack = "Ninguno"

    -- Se restauran los IDs guardados. Nunca se destruye el LocalScript Animate.
    animate.Enabled = false
    for _, node in ipairs(AnimationNodes) do
        local animation = getAnimationObject(animate, node)
        local originalId = snapshot[node.Key]
        if animation and type(originalId) == "string" and originalId ~= "" then
            animation.AnimationId = originalId
        end
    end

    stopCharacterAnimationTracks(hum)
    task.wait(0.08)

    if LP.Character ~= char or not animate.Parent then
        return false
    end
    animate.Enabled = true

    if hum.Health > 0 then
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end)
        task.wait(0.05)
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    return true
end

