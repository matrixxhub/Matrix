        local stickFrame = touchFrame:FindFirstChild("DynamicThumbstickFrame")
            or touchFrame:FindFirstChild("ThumbstickFrame")
        if not stickFrame or not stickFrame:IsA("GuiObject") then
            return false
        end

        local topLeft = stickFrame.AbsolutePosition
        local bottomRight = topLeft + stickFrame.AbsoluteSize
        return position.X >= topLeft.X
            and position.Y >= topLeft.Y
            and position.X <= bottomRight.X
            and position.Y <= bottomRight.Y
    end

    local function CreateMatrixRipple(position)
        if ActiveRippleCount >= MAX_ACTIVE_RIPPLES then return end
        ActiveRippleCount += 1

        local ripple = Instance.new("Frame")
        ripple.Name = "MatrixRipple"
        ripple.AnchorPoint = Vector2.new(0.5, 0.5)
        ripple.Position = UDim2.fromOffset(position.X, position.Y)
        ripple.Size = UDim2.fromOffset(12, 12)
        ripple.BackgroundTransparency = 1
        ripple.BorderSizePixel = 0
        ripple.Active = false
        ripple.Selectable = false
        ripple.ZIndex = 20
        ripple.Parent = RippleGui

        local round = Instance.new("UICorner")
        round.CornerRadius = UDim.new(1, 0)
        round.Parent = ripple

        local outline = Instance.new("UIStroke")
        outline.Color = Color3.fromRGB(0, 255, 125)
        outline.Thickness = 2.5
        outline.Transparency = 0.08
        outline.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        outline.Parent = ripple

        local centerDot = Instance.new("Frame")
        centerDot.Name = "CenterDot"
        centerDot.AnchorPoint = Vector2.new(0.5, 0.5)
        centerDot.Position = UDim2.fromScale(0.5, 0.5)
        centerDot.Size = UDim2.fromOffset(4, 4)
        centerDot.BackgroundColor3 = Color3.fromRGB(120, 255, 180)
        centerDot.BorderSizePixel = 0
        centerDot.Active = false
        centerDot.Selectable = false
        centerDot.ZIndex = 21
        centerDot.Parent = ripple

        local dotCorner = Instance.new("UICorner")
        dotCorner.CornerRadius = UDim.new(1, 0)
        dotCorner.Parent = centerDot

        -- Efecto más inmediato: el aro empieza a expandirse en cuanto aparece.
        local expandInfo = TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(ripple, expandInfo, {
            Size = UDim2.fromOffset(54, 54)
        }):Play()
        TweenService:Create(outline, expandInfo, {
            Transparency = 1,
            Thickness = 1
        }):Play()
        TweenService:Create(centerDot, expandInfo, {
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(2, 2)
        }):Play()

        task.delay(0.39, function()
            if ripple and ripple.Parent then ripple:Destroy() end
            ActiveRippleCount = math.max(0, ActiveRippleCount - 1)
        end)
    end

    local function SetMatrixRippleEnabled(enabled)
        RippleEnabled = enabled == true
        RippleGui.Enabled = RippleEnabled

        if RippleConnection then
            RippleConnection:Disconnect()
            RippleConnection = nil
        end
        if RippleEnv.MATRIXHUB_TOUCH_RIPPLE_CONNECTION then
            RippleEnv.MATRIXHUB_TOUCH_RIPPLE_CONNECTION = nil
        end

        if not RippleEnabled then
            for _, child in ipairs(RippleGui:GetChildren()) do
                child:Destroy()
            end
            ActiveRippleCount = 0
            return
        end

        -- TouchStarted recibe directamente el inicio de cada toque.
        -- No filtramos gameProcessed para poder mostrar toques sobre botones del juego;
        -- únicamente excluimos el joystick móvil.
        RippleConnection = RippleInputService.TouchStarted:Connect(function(input, gameProcessed)
            if not RippleEnabled then return end
            local position = Vector2.new(input.Position.X, input.Position.Y)
            if IsTouchOnMobileJoystick(position) then return end
            CreateMatrixRipple(position)
        end)
        RippleEnv.MATRIXHUB_TOUCH_RIPPLE_CONNECTION = RippleConnection
    end

    Visuales:Section({ Title = "TOUCH EFFECTS", Icon = "mouse-pointer-2", Opened = true })
    Visuales:Toggle({
        Title = "MATRIX RIPPLE",
        Icon = "target",
        Value = false,
        Callback = SetMatrixRippleEnabled
    })
end

