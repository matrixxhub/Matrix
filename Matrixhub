local MATRIXHUB_flying = false
local MATRIXHUB_CONFIG_STATUS = "CONFIGURACIÓN PREDETERMINADA"
local MATRIXHUB_ERROR_LOG = {}
local function RecordMatrixHubError(source, message)
    local entry = os.date("%H:%M:%S") .. " | " .. tostring(source) .. " | " .. tostring(message)
    table.insert(MATRIXHUB_ERROR_LOG, entry)
    while #MATRIXHUB_ERROR_LOG > 12 do table.remove(MATRIXHUB_ERROR_LOG, 1) end
end
local matrixConfigDirty = false
local matrixSaveGeneration = 0

local function LoadMatrixHubConfig()
    if type(readfile) ~= "function" then
        MATRIXHUB_CONFIG_STATUS = "LECTURA NO DISPONIBLE"
        return false
    end

    local raw
    for _, path in ipairs({ MATRIXHUB_CONFIG_PATH, MATRIXHUB_CONFIG_FALLBACK_PATH }) do
        local okRead, result = pcall(readfile, path)
        if okRead and type(result) == "string" and result ~= "" then
            raw = result
            break
        end
    end
    if not raw then
        MATRIXHUB_CONFIG_STATUS = "NUEVA CONFIGURACIÓN"
        return false
    end

    local okDecode, saved = pcall(function()
        return MatrixHubHttpService:JSONDecode(raw)
    end)
    if not okDecode or type(saved) ~= "table" then
        MATRIXHUB_CONFIG_STATUS = "ARCHIVO INVÁLIDO: SE USARÁN VALORES SEGUROS"
        RecordMatrixHubError("CONFIG LOAD", "No se pudo interpretar el archivo JSON")
        if type(writefile) == "function" then
            pcall(writefile, "MATRIXHUB/MatrixHubConfig.invalid.json", raw)
        end
        return false
    end

    if type(saved.ExecutionCount) == "number" then MATRIXHUB_CONFIG.ExecutionCount = math.max(0, math.floor(saved.ExecutionCount)) end
    if type(saved.Theme) == "string" then MATRIXHUB_CONFIG.Theme = saved.Theme end
    local savedSlot2CPS = tonumber(saved.GunSlotSpamCPS)
    if savedSlot2CPS then MATRIXHUB_CONFIG.GunSlotSpamCPS = math.clamp(math.floor(savedSlot2CPS), 2, 15) end
    for _, key in ipairs({ "FPSBoost", "AntiLag", "StatusHud", "GlowEnabled", "UIAudioEnabled", "KillSoundEnabled", "UseCustomKillSound" }) do
        if type(saved[key]) == "boolean" then MATRIXHUB_CONFIG[key] = saved[key] end
    end
    for key, limits in pairs({
        UIScale = { 0.75, 1.35 },
        AnimationSpeed = { 0.5, 1.75 },
        AccentIntensity = { 0.35, 1 },
        PanelTransparency = { 0, 0.45 },
        UIAudioVolume = { 0, 1 },
        KillSoundVolume = { 1, 3 }
    }) do
        if type(saved[key]) == "number" then
            MATRIXHUB_CONFIG[key] = math.clamp(saved[key], limits[1], limits[2])
        end
    end
    if type(saved.ButtonVisibility) == "table" then
        for _, buttonId in ipairs({ "Fantasma", "Silent", "AutoShoot", "Fly" }) do
            if type(saved.ButtonVisibility[buttonId]) == "boolean" then
                MATRIXHUB_CONFIG.ButtonVisibility[buttonId] = saved.ButtonVisibility[buttonId]
            end
        end
    end
    if type(saved.Keybinds) == "table" then
        for _, actionName in ipairs({ "Menu", "Fly", "Fantasma", "Silent", "AutoShoot" }) do
            local keyName = saved.Keybinds[actionName]
            if type(keyName) == "string" and Enum.KeyCode[keyName] and Enum.KeyCode[keyName] ~= Enum.KeyCode.Unknown then
                MATRIXHUB_CONFIG.Keybinds[actionName] = keyName
            end
        end
    end
    if type(saved.QuickButtonPositions) == "table" then
        for _, buttonId in ipairs({ "Fantasma", "Silent", "AutoShoot", "Fly" }) do
            local pos = saved.QuickButtonPositions[buttonId]
            if type(pos) == "table" then
                local target = MATRIXHUB_CONFIG.QuickButtonPositions[buttonId]
