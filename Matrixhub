local function closeMatrixStartup()
    if not startupGui or not startupGui.Parent then return end
    if startupRainConnection then startupRainConnection:Disconnect() startupRainConnection = nil end
    local fadeInfo = TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    TweenService:Create(startupTitle, fadeInfo, {
        TextTransparency = 1,
        TextStrokeTransparency = 1,
        Position = UDim2.fromScale(0.5, 0.46)
    }):Play()
    TweenService:Create(startupSubtitle, fadeInfo, { TextTransparency = 1 }):Play()
    for _, column in ipairs(startupRain) do
        if column.Label and column.Label.Parent then
            TweenService:Create(column.Label, fadeInfo, { TextTransparency = 1 }):Play()
        end
    end
    TweenService:Create(startupBackground, fadeInfo, { BackgroundTransparency = 1 }):Play()
    task.wait(0.58)
    if startupGui and startupGui.Parent then startupGui:Destroy() end
end



