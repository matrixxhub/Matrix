-- El splash permanece durante la carga real y tiene una duración mínima visible.
-- No se muestra porcentaje, barra ni contador: solo la lluvia digital.
task.spawn(function()
    local startupStartedAt = os.clock()
    local ok, err = pcall(launchMatrixHub)
    if not ok then warn("[MATRIXHUB] Error al iniciar: " .. tostring(err)) end
    local elapsed = os.clock() - startupStartedAt
    local minimumDisplayTime = 3.5
    if elapsed < minimumDisplayTime then
        task.wait(minimumDisplayTime - elapsed)
    end
    closeMatrixStartup()
end)
