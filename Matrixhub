-- FOV CAMERA // 0 en el slider equivale al FOV base de 70 grados.
do
    local fovEnabled = false
    local fovOffset = 0
    local originalFovByCamera = setmetatable({}, { __mode = "k" })

    local function applyMatrixFov(camera)
        if not camera or not fovEnabled then return end
        if originalFovByCamera[camera] == nil then
            originalFovByCamera[camera] = camera.FieldOfView
        end
        camera.FieldOfView = math.clamp(70 + fovOffset, 1, 120)
    end

    local function restoreMatrixFov(camera)
        if not camera then return end
        local original = originalFovByCamera[camera]
        if original ~= nil then
            camera.FieldOfView = original
            originalFovByCamera[camera] = nil
        end
    end

    workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local camera = workspace.CurrentCamera
        if fovEnabled then applyMatrixFov(camera) end
    end)

    Visuales:Toggle({
        Title = "FOV CAMERA",
        Value = false,
        Callback = function(enabled)
            fovEnabled = enabled == true
            local camera = workspace.CurrentCamera
            if fovEnabled then
                applyMatrixFov(camera)
            else
                for savedCamera in pairs(originalFovByCamera) do
                    restoreMatrixFov(savedCamera)
                end
            end
        end
    })

    Visuales:Slider({
        Title = "AUMENTO DE FOV (0 = 70°)",
        Step = 1,
        Value = { Min = 0, Max = 50, Default = 0 },
        Callback = function(value)
            fovOffset = math.clamp(math.floor(tonumber(value) or 0), 0, 50)
            if fovEnabled then applyMatrixFov(workspace.CurrentCamera) end
        end
    })
end

