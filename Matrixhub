    local frames = 0
    local elapsed = 0
    local fps = 0
    local fpsHistory = {}
    local hudConnection
    local function getMemoryMb()
        local ok, value = pcall(function()
            return StatsService:GetTotalMemoryUsageMb()
        end)
        if ok and type(value) == "number" then
            return math.floor(value + 0.5)
        end
        return nil
    end
    local function makeFpsGraph(value)
        local levels = { "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" }
        local level = math.clamp(math.floor(math.clamp(value, 0, 120) / 120 * 8), 1, 8)
        fpsHistory[#fpsHistory + 1] = levels[level]
        while #fpsHistory > 14 do table.remove(fpsHistory, 1) end
        return table.concat(fpsHistory)
    end
    local function getPingMs()
        local ok, value = pcall(function()
            return StatsService.Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        if ok and type(value) == "number" then return math.floor(value + 0.5) end
        local okText, textValue = pcall(function()
            return StatsService.Network.ServerStatsItem["Data Ping"]:GetValueString()
        end)
        if okText and type(textValue) == "string" then
            local number = tonumber(textValue:match("[%d%.]+"))
            if number then return math.floor(number + 0.5) end
        end
        return nil
    end
    local hudAccumulator = 0
    hudConnection = RunService.RenderStepped:Connect(function(dt)
        if not hudGui.Parent then
            if hudConnection then hudConnection:Disconnect() end
            return
        end
        -- El monitor también alimenta OVERVIEW; no debe depender de que el HUD flotante esté visible.
        frames += 1
        elapsed += dt
        hudAccumulator += dt
        if hudAccumulator < 0.5 then return end
        local sampleTime = math.max(elapsed, 0.001)
        fps = math.floor(frames / sampleTime + 0.5)
        frames = 0
        elapsed = 0
        hudAccumulator = 0

        local ping = getPingMs()
        local playersNow = #Players:GetPlayers()
        local maxPlayers = Players.MaxPlayers
        local pingText = ping and (tostring(ping) .. " ms") or "N/D"
        local memoryMb = getMemoryMb()
        local memoryText = memoryMb and (tostring(memoryMb) .. " MB") or "N/D"
        local performanceAlert = fps < 25 or (ping ~= nil and ping > 180)
        local fpsGraph = makeFpsGraph(fps)
        info.Text = string.format(
            "FPS: %d   PING: %s\nPLAYERS: %d/%d\nERRORS: %d",
            fps, pingText, playersNow, maxPlayers, #MATRIXHUB_ERROR_LOG
        )
        if MATRIXHUB_HOME_PERFORMANCE_PARAGRAPH then
            local homeText = string.format(
                "▣ FPS  %d      ◈ PING  %s\n▤ MEMORIA  %s      ♟ JUGADORES  %d/%d\n\nFPS HISTORY  %s",
                fps, pingText, memoryText, playersNow, maxPlayers, fpsGraph
            )
            pcall(function()
                MATRIXHUB_HOME_PERFORMANCE_PARAGRAPH:SetDesc(homeText)
            end)
        end
        if performanceAlert then
            hudStroke.Color = Color3.fromRGB(255, 175, 65)
            header.TextColor3 = Color3.fromRGB(255, 205, 125)
        else
            local intensity = MATRIXHUB_CONFIG.AccentIntensity
            local accent = Color3.fromRGB(0, 200, 90):Lerp(Color3.fromRGB(0, 90, 40), 1 - intensity)
            hudStroke.Color = accent
            header.TextColor3 = Color3.fromRGB(110, 255, 170)
        end
    end)

    -- Se retiraron los controles de personalización que no aplicaban correctamente.
    Settings:Toggle({
        Title = "STATUS",
        Icon = "activity",
        Value = MATRIXHUB_CONFIG.StatusHud == true,
        Callback = function(enabled)
            hudGui.Enabled = enabled == true
            MATRIXHUB_CONFIG.StatusHud = enabled == true
            SaveMatrixHubConfig()
            PlayMatrixUISound("Toggle")
        end
    })

    MATRIXHUB_LIVE_HUD = hudGui
    MATRIXHUB_LIVE_HUD_LABEL = info
end

