            TweenService:Create(
                particle,
                TweenInfo.new(0.82 + (i % 5) * 0.035, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, i * 0.018),
                {Position = target, TextTransparency = 0}
