        for _, key in ipairs({ "Click", "Toggle", "Notice" }) do
            if type(saved.UISounds[key]) == "string" then
                MATRIXHUB_CONFIG.UISounds[key] = saved.UISounds[key]:gsub("%D", ""):sub(1, 20)
