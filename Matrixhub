    _G.MATRIXHUB_SetSlot2Spam = function(enabled)
        enabled = enabled == true
        if enabled == (_G.MATRIXHUB_SLOT2_SPAM_ENABLED == true) then return end

        if enabled and not MATRIXHUB_FindSlot2Pistol() then
            MATRIXHUB_UpdateSlot2Info("No se encontró la pistola en el inventario.")
            warn("[Matrix Hub] Auto Slot 2: no se encontró una pistola.")
            return
        end

        _G.MATRIXHUB_SLOT2_SPAM_ENABLED = enabled
        MATRIXHUB_SLOT2_WORKER_ID += 1
        local workerId = MATRIXHUB_SLOT2_WORKER_ID

        if enabled then
            task.spawn(function()
                while _G.MATRIXHUB_SLOT2_SPAM_ENABLED and workerId == MATRIXHUB_SLOT2_WORKER_ID do
                    local character = LocalPlayer.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    local pistol = MATRIXHUB_FindSlot2Pistol()

                    if not character or not humanoid then
                        task.wait(0.15)
                    elseif not pistol then
                        _G.MATRIXHUB_SLOT2_SPAM_ENABLED = false
                        MATRIXHUB_SLOT2_WORKER_ID += 1
                        warn("[Matrix Hub] Auto Slot 2 detenido: la pistola ya no está en el inventario.")
                        break
                    else
                        local ok, equipError = pcall(function()
                            if pistol.Parent == character then
                                humanoid:UnequipTools()
                            else
                                humanoid:EquipTool(pistol)
                            end
                        end)

                        if not ok then
                            _G.MATRIXHUB_SLOT2_SPAM_ENABLED = false
                            MATRIXHUB_SLOT2_WORKER_ID += 1
                            RecordMatrixHubError("AUTO SLOT 2", equipError)
                            warn("[Matrix Hub] Auto Slot 2 detenido por un error: " .. tostring(equipError))
                            break
                        end

                        local cps = math.clamp(MATRIXHUB_CPS_VALUE, MATRIXHUB_CPS_MIN, MATRIXHUB_CPS_MAX)
                        task.wait(1 / cps)
                    end
                end

                MATRIXHUB_UpdateSlot2Info()
            end)
        end

        MATRIXHUB_UpdateSlot2Info()
        PlayMatrixUISound("Toggle")
    end

