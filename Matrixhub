                    XS = { 0, 1 }, XO = { -4000, 4000 },
                    YS = { 0, 1 }, YO = { -4000, 4000 }
                }) do
                    if type(pos[field]) == "number" then
                        target[field] = math.clamp(pos[field], limits[1], limits[2])
                    end
                end
            end
        end
    end
