        MATRIXHUB_CONFIG.CustomKillSoundId = saved.CustomKillSoundId:gsub("%D", ""):sub(1, 20)
    end
    if type(saved.UseCustomKillSound) == "boolean" then
        MATRIXHUB_CONFIG.UseCustomKillSound = saved.UseCustomKillSound
    end
    if type(saved.SelectedKillSound) == "string" then
        MATRIXHUB_CONFIG.SelectedKillSound = saved.SelectedKillSound
    end

    MATRIXHUB_CONFIG_STATUS = "CONFIGURACIÓN CARGADA"
    return true
end

local function WriteMatrixHubConfig()
    if type(writefile) ~= "function" then
        MATRIXHUB_CONFIG_STATUS = "GUARDADO NO DISPONIBLE EN ESTE EJECUTOR"
        return false, MATRIXHUB_CONFIG_STATUS
    end
    if type(makefolder) == "function" then
        local folderExists = false
        if type(isfolder) == "function" then
            local okFolder, exists = pcall(isfolder, "MATRIXHUB")
            folderExists = okFolder and exists == true
        end
        if not folderExists then pcall(makefolder, "MATRIXHUB") end
    end

    local okEncode, encoded = pcall(function()
        MATRIXHUB_CONFIG.SchemaVersion = 2
        return MatrixHubHttpService:JSONEncode(MATRIXHUB_CONFIG)
    end)
    if not okEncode or type(encoded) ~= "string" then
        MATRIXHUB_CONFIG_STATUS = "ERROR AL PREPARAR CONFIGURACIÓN"
        return false, MATRIXHUB_CONFIG_STATUS
    end

    local lastError
    for _, path in ipairs({ MATRIXHUB_CONFIG_PATH, MATRIXHUB_CONFIG_FALLBACK_PATH }) do
        local okWrite, writeError = pcall(writefile, path, encoded)
        if okWrite then
            MATRIXHUB_CONFIG_STATUS = "CONFIGURACIÓN GUARDADA"
            matrixConfigDirty = false
            return true
        end
        lastError = writeError
    end
    MATRIXHUB_CONFIG_STATUS = "ERROR AL ESCRIBIR CONFIGURACIÓN"
    return false, tostring(lastError or MATRIXHUB_CONFIG_STATUS)
end

local function SaveMatrixHubConfig(force)
    matrixConfigDirty = true
    matrixSaveGeneration += 1
    local generation = matrixSaveGeneration
    if force == true then
        local ok, err = WriteMatrixHubConfig()
        if not ok then
            RecordMatrixHubError("CONFIG SAVE", err)
            warn("[Matrix Hub] " .. tostring(err))
        end
        return ok
    end

    task.delay(0.65, function()
        if generation ~= matrixSaveGeneration or not matrixConfigDirty then return end
        local ok, err = WriteMatrixHubConfig()
        if not ok then
            RecordMatrixHubError("CONFIG SAVE", err)
            warn("[Matrix Hub] " .. tostring(err))
        end
    end)
    return true
end

