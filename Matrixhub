    local ghostMessageActive = false
    local ghostMessageY = -0.12
    local ghostMessageSpeed = 0.2
    local nextGhostMessageAt = os.clock() + rng:NextNumber(5, 9)
    local updateInterval = 1 / 15
    local accumulator = 0
    local rainConnection
    rainConnection = RunService.Heartbeat:Connect(function(dt)
        if not mainWindow.Parent or not rainFrame.Parent then
            if rainConnection then rainConnection:Disconnect() end
            return
        end

        local expanded = mainWindow.Visible
            and mainWindow.AbsoluteSize.X >= 300
            and mainWindow.AbsoluteSize.Y >= 250
        rainFrame.Visible = expanded
        if not expanded then
            accumulator = 0
            return
        end

        accumulator += dt
        if accumulator < updateInterval then return end
        local step = math.min(accumulator, 0.12)
        accumulator = 0

        for _, column in ipairs(columns) do
            column.Y += step * column.Speed
            if column.Y >= 1.08 then
                column.Y = -0.30
                column.Label.Text = randomStream(10)
            end
            column.Label.Position = UDim2.new(column.X, 0, column.Y, 0)
        end

        for _, word in ipairs(wordColumns) do
            word.Y += step * word.Speed
            if word.Y >= 1.08 then
                word.Y = -0.12
                word.Label.Text = identityWords[rng:NextInteger(1, #identityWords)]
            end
            word.Label.Position = UDim2.new(word.X, 0, word.Y, 0)
        end

        -- Se intenta mostrar un mensaje cada 5-9 segundos. La probabilidad
        -- individual de cada frase va del 30% al 5%, según su misterio.
        local now = os.clock()
        if not ghostMessageActive and now >= nextGhostMessageAt then
            nextGhostMessageAt = now + rng:NextNumber(5, 9)
            local entry = trappedMessages[rng:NextInteger(1, #trappedMessages)]
            if rng:NextInteger(1, 100) <= entry.Chance then
